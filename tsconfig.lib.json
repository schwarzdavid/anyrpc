{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.json.tsbuildinfo",
        "outDir": "dist",
        "declarationDir": "dist",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "examples"],
    "exclude": [
        "src/lib/adapter/node-worker/**",
        "src/lib/adapter/web-worker/WebWorkerClientAdapter.ts",
        "src/lib/adapter/web-worker/SharedWorkerHubAdapter.ts",
        "src/lib/adapter/web-worker/SharedWorkerPeerAdapter.ts",
        "examples/node-worker/**",
        "examples/websocket/server.ts",
        "examples/**/*.worker.ts"
    ]
}
