{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.json.tsbuildinfo",
        "outDir": "dist",
        "declarationDir": "dist",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "examples"],
    "exclude": ["src/lib/adapter/web-worker/WebWorkerClientAdapter.ts", "examples/**/*.worker.ts"]
}
