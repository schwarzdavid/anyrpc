{
  "name": "anyrpc",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "format": "prettier . -c",
    "format:fix": "prettier . -w",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "tsc --build --force",
    "build": "vite build",
    "dev": "vite",
    "preversion": "concurrently 'npm run format' 'npm run lint' 'npm run check'",
    "prepublishOnly": "npm run build",
    "test": "vitest run --typecheck",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "David Schwarz <david@ists-wurscht.at>",
  "license": "ISC",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/iframe": {
      "types": "./dist/lib/adapter/iframe/index.d.ts",
      "import": "./dist/iframe.js",
      "require": "./dist/iframe.cjs"
    },
    "./adapters/message-port": {
      "types": "./dist/lib/adapter/message-port/index.d.ts",
      "import": "./dist/message-port.js",
      "require": "./dist/message-port.cjs"
    },
    "./adapters/web-worker/host": {
      "types": "./dist/lib/adapter/web-worker/host/index.d.ts",
      "import": "./dist/web-worker-host.js",
      "require": "./dist/web-worker-host.cjs"
    },
    "./adapters/web-worker/client": {
      "types": "./dist/lib/adapter/web-worker/client/index.d.ts",
      "import": "./dist/web-worker-client.js",
      "require": "./dist/web-worker-client.cjs"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/browser-playwright": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/eslint-plugin": "^1.5.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "playwright": "^1.64.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.0.16"
  },
  "dependencies": {
    "type-fest": "^5.10.0"
  }
}
