{
  "name": "anyrpc",
  "version": "0.0.1-alpha.0",
  "description": "",
  "scripts": {
    "format": "prettier . -c",
    "format:fix": "prettier . -w",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "tsc --build --force",
    "build": "vite build",
    "dev": "vite",
    "preversion": "concurrently npm:format npm:lint npm:check",
    "prepublishOnly": "npm run build",
    "test": "vitest run --typecheck",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "David Schwarz <david@ists-wurscht.at>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schwarzdavid/anyrpc.git"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/iframe": {
      "types": "./dist/lib/adapter/iframe/index.d.ts",
      "import": "./dist/iframe.js",
      "require": "./dist/iframe.cjs"
    },
    "./adapters/message-port": {
      "types": "./dist/lib/adapter/message-port/index.d.ts",
      "import": "./dist/message-port.js",
      "require": "./dist/message-port.cjs"
    },
    "./adapters/web-worker": {
      "types": "./dist/lib/adapter/web-worker/index.d.ts",
      "import": "./dist/web-worker.js",
      "require": "./dist/web-worker.cjs"
    },
    "./adapters/node-worker": {
      "types": "./dist/lib/adapter/node-worker/index.d.ts",
      "import": "./dist/node-worker.js",
      "require": "./dist/node-worker.cjs"
    },
    "./adapters/child-process": {
      "types": "./dist/lib/adapter/child-process/index.d.ts",
      "import": "./dist/child-process.js",
      "require": "./dist/child-process.cjs"
    },
    "./adapters/socket": {
      "types": "./dist/lib/adapter/socket/index.d.ts",
      "import": "./dist/socket.js",
      "require": "./dist/socket.cjs"
    },
    "./adapters/websocket": {
      "types": "./dist/lib/adapter/websocket/index.d.ts",
      "import": "./dist/websocket.js",
      "require": "./dist/websocket.cjs"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/eslint-plugin": "^1.5.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "playwright": "^1.64.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.0.16",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "type-fest": "^5.10.0"
  }
}
