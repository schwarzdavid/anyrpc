{
  "name": "@schwarzdavid/anyrpc",
  "version": "0.0.2-alpha.1",
  "description": "Fully typed, transport-agnostic, bidirectional RPC for TypeScript, based on JSON-RPC 2.0. Adapters for iframes, Web Workers, SharedWorkers, WebSockets, Node.js worker threads and child processes.",
  "scripts": {
    "format": "prettier . -c",
    "format:fix": "prettier . -w",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "tsc --build --force",
    "build": "vite build",
    "dev": "vite",
    "preversion": "concurrently npm:format npm:lint npm:check",
    "prepublishOnly": "npm run build",
    "test": "vitest run --typecheck",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "rpc",
    "json-rpc",
    "typescript",
    "typed",
    "bidirectional",
    "postmessage",
    "iframe",
    "web-worker",
    "shared-worker",
    "websocket",
    "worker-threads",
    "child-process",
    "ipc",
    "messagechannel"
  ],
  "author": "David Schwarz <david@schwarzdavid.at>",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schwarzdavid/anyrpc.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/iframe": {
      "types": "./dist/iframe.d.ts",
      "default": "./dist/iframe.js"
    },
    "./adapters/message-port": {
      "types": "./dist/message-port.d.ts",
      "default": "./dist/message-port.js"
    },
    "./adapters/web-worker": {
      "types": "./dist/web-worker.d.ts",
      "default": "./dist/web-worker.js"
    },
    "./adapters/node-worker": {
      "types": "./dist/node-worker.d.ts",
      "default": "./dist/node-worker.js"
    },
    "./adapters/child-process": {
      "types": "./dist/child-process.d.ts",
      "default": "./dist/child-process.js"
    },
    "./adapters/socket": {
      "types": "./dist/socket.d.ts",
      "default": "./dist/socket.js"
    },
    "./adapters/websocket": {
      "types": "./dist/websocket.d.ts",
      "default": "./dist/websocket.js"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "^1.5.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "playwright": "^1.64.1",
    "prettier": "^3.7.4",
    "rolldown-plugin-dts": "^0.30.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.3.8",
    "vitest": "4.1.12",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "type-fest": "^5.10.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
