{
  "name": "anyrpc",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "format": "prettier . -c",
    "format:fix": "prettier . -w",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "tsc --build --force",
    "build": "vite build",
    "preversion": "concurrently 'npm run format' 'npm run lint' 'npm run check'",
    "prepublishOnly": "npm run build",
    "test": "vitest run --typecheck",
    "test:unit": "vitest run --project unit --typecheck",
    "test:browser": "vitest run --project browser --headless",
    "test:watch:unit": "vitest --project unit",
    "test:watch:browser": "vitest --project browser",
    "coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "David Schwarz <david@ists-wurscht.at>",
  "license": "ISC",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/iframe": {
      "types": "./dist/iframe.d.ts",
      "import": "./dist/iframe.js",
      "require": "./dist/iframe.cjs"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/browser-playwright": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/eslint-plugin": "^1.5.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "type-fest": "^5.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.0.16"
  }
}
