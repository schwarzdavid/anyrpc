{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.node.json.tsbuildinfo",
        "lib": ["ESNext"],
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"],
            "anyrpc": ["./src/index.ts"],
            "anyrpc/adapters/*": ["./src/lib/adapter/*/index.ts"]
        }
    },
    "include": ["src/index.ts", "src/lib/adapter/message-port/index.ts"]
}
