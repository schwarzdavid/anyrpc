{
    "extends": "./tsconfig.lib.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.json.tsbuildinfo",
        "noEmit": true,
        "types": ["node", "vite/client"]
    },
    "include": ["src", "test"],
    "exclude": [
        "src/lib/adapter/web-worker/WebWorkerClientAdapter.ts",
        "src/lib/adapter/web-worker/SharedWorkerHubAdapter.ts",
        "src/lib/adapter/web-worker/SharedWorkerPeerAdapter.ts",
        "test/unit/**/*.worker.test.ts",
        "test/unit/**/*.worker.test-d.ts",
        "test/**/*.worker.ts"
    ]
}
